# Optional integration placeholders only. The M1 scaffold does not load them.
# These names are provider-neutral and do not select an LLM, tunnel, or mail service.
# Replace values only in an ignored .env file after the corresponding ADR is accepted.
COP_OPTIONAL_PROVIDER_API_KEY=dummy-not-a-real-key
COP_OPTIONAL_TUNNEL_TOKEN=dummy-not-a-real-token
COP_OPTIONAL_EMAIL_CREDENTIALS_PATH=dummy/path/credentials.json

# Never commit a real .env file, token, OAuth secret, credential, or commitment nonce.
