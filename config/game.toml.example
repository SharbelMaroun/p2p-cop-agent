# Cop-private local configuration example. Never share, sign, or parity-control it.
#
# Section and key names follow the skeleton the book publishes on page 131 and the
# reference implementation's own `config/police/game.toml`, both checked 2026-07-31.
# The real file is `config/game.toml`, which is git-ignored; every value below is an
# inert placeholder.
#
# The split is the whole point (ADR-004): anything that shapes the *game* lives in
# the shared, signed match JSON, and anything that is nobody else's concern -- our
# port, the opponent's address, model choice, credentials -- stays here so that it
# can never leak into the agreement.

version = "1.00"

# Book page 131 and the audit of 2026-08-01: the [game] block must carry the group
# identity, the sub-game number, the member list, and the repository URLs — not just
# the two names this example previously held.
[game]
group_name = "private-unconfigured"
group_id = "private-unconfigured"
sub_game_number = 1
members = ["private-unconfigured"]
repos = { cop = "https://example.invalid/cop", thief = "https://example.invalid/thief" }

# The opponent's address is private local knowledge and is read ONLY from here, by
# `shared.private_config.load_opponent_url`. The shared match JSON must carry no
# URL, port, or host at all; `assert_no_network_address` enforces that.
[network]
my_port = 0
opponent_url = "https://opponent.invalid/mcp"
# Our own public tunnel address, advertised to the peer as `mcp_servers` during
# negotiation (M5-07b). Provider-neutral: any https URL (ngrok, cloudflare, a
# self-hosted domain) works. The token that authorises the tunnel is a secret and
# belongs in an ignored .env, never here and never in the shared JSON.
public_url = "https://self.invalid/mcp"
turn_timeout_seconds = 180
poll_interval_seconds = 1
connect_timeout_seconds = 10
retry_interval_seconds = 5
audit_send_timeout_seconds = 60

[strategy]
name = "private-unconfigured"

[llm]
model = "private-unconfigured"
step_deadline_seconds = 30

[email]
recipient = "private-unconfigured"
mode = "draft"

# Credentials, tunnel tokens, API keys, signing secrets, and per-turn commitment
# nonces belong in an ignored .env or credential store -- never in this example,
# never in this file, and never in any shared JSON.
