{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-version": "0.2.6-proposed",
  "x-source-status": "PROPOSED",
  "title": "Operational Gatekeeper mirror configuration",
  "description": "Per-run file-backed enforcement mirror. Values must equal the authoritative signed match configuration Gatekeeper section.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "rate_limiter_gatekeeper",
    "extensions"
  ],
  "properties": {
    "version": {
      "const": "1.00",
      "description": "PROPOSED root placement of the guidelines configuration revision."
    },
    "rate_limiter_gatekeeper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_per_minute",
        "concurrent_requests",
        "retry_backoff_sec",
        "max_retries",
        "queue_depth"
      ],
      "properties": {
        "requests_per_minute": {
          "type": "integer",
          "minimum": 30,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "concurrent_requests": {
          "type": "integer",
          "minimum": 2,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "retry_backoff_sec": {
          "type": "number",
          "minimum": 5,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 3,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "queue_depth": {
          "type": "integer",
          "minimum": 100,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Peer-local extension namespace; contents are not match terms and must not override the Gatekeeper mirror."
    }
  }
}
