{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-version": "0.1.0-proposed",
  "x-source-status": "PROPOSED",
  "title": "Proposed negotiated match Gatekeeper configuration",
  "description": "PROPOSED split companion to game.json; Appendix B embeds these values and the formal artifact split is unresolved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema_version",
    "game_id",
    "sub_game_number",
    "rate_limiter_gatekeeper",
    "extensions"
  ],
  "properties": {
    "version": {
      "const": "1.00",
      "description": "PROPOSED root placement of the guidelines configuration revision."
    },
    "schema_version": {
      "const": "1.2",
      "description": "PROPOSED reuse of the Appendix B game example profile."
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "sub_game_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "rate_limiter_gatekeeper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_per_minute",
        "concurrent_requests",
        "retry_backoff_sec",
        "max_retries",
        "queue_depth",
        "response_timeout_sec",
        "watchdog_timeout_sec"
      ],
      "properties": {
        "requests_per_minute": {
          "type": "integer",
          "minimum": 30,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "concurrent_requests": {
          "type": "integer",
          "minimum": 2,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "retry_backoff_sec": {
          "type": "number",
          "minimum": 5,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 3,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "queue_depth": {
          "type": "integer",
          "minimum": 100,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "response_timeout_sec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-appendix-f-status": "negotiated",
          "x-value-owner": "mutual_agreement"
        },
        "watchdog_timeout_sec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-appendix-f-status": "negotiated",
          "x-value-owner": "mutual_agreement"
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "PROPOSED explicit extension namespace; contents must be mutually agreed."
    }
  }
}
