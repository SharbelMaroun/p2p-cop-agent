{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-version": "0.1.0-proposed",
  "title": "Shared configuration SHA-256 vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_version",
    "source_path",
    "scope",
    "serialization",
    "canonical_utf8_length",
    "sha256"
  ],
  "properties": {
    "vector_version": {
      "const": "1.0"
    },
    "source_path": {
      "const": "config/game.json"
    },
    "scope": {
      "const": "complete parsed root object; hash claim and artifact wrapper are external"
    },
    "serialization": {
      "const": "sorted keys; compact separators ',' and ':'; unescaped Unicode; UTF-8"
    },
    "canonical_utf8_length": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
