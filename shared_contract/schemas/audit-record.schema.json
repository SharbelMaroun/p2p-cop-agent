{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-version": "0.2.5-proposed",
  "x-role-neutral": true,
  "title": "Option-B audit record",
  "description": "One post-game record whose payload and revealed commitment nonce must reproduce commit.",
  "type": "object",
  "required": ["payload", "nonce", "commit"],
  "additionalProperties": true,
  "properties": {
    "payload": {
      "type": "object"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "Per-turn commitment nonce, secret before this post-game audit reveal.",
      "x-purpose": "per-turn-commitment-nonce",
      "x-visibility": "audit-only"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
