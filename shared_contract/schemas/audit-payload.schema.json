{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-version": "0.2.3-proposed",
  "x-role-neutral": true,
  "x-compatibility-profile": "simulator-v3.0.0",
  "title": "simulator-v3.0.0 AuditPayload",
  "description": "Post-game reveal delivered to submit_audit under the simulator-v3.0.0 compatibility profile.",
  "type": "object",
  "required": ["sender", "records", "result_claim"],
  "additionalProperties": true,
  "properties": {
    "sender": {
      "enum": ["police", "thief"]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["payload", "nonce", "commit"],
        "additionalProperties": true,
        "properties": {
          "payload": {
            "type": "object"
          },
          "nonce": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "description": "Per-turn commitment nonce, secret before this post-game audit reveal.",
            "x-purpose": "per-turn-commitment-nonce",
            "x-visibility": "audit-only"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "result_claim": {
      "enum": ["capture", "survival", "timeout"]
    }
  }
}
