{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-version": "0.2.10-proposed",
  "x-source-status": "PROPOSED",
  "x-role-neutral": true,
  "title": "Option-B per-match shared game configuration",
  "description": "Role-neutral schema for a per-match shared game object supplied at runtime by explicit path. It is not an active match and not the emitted agreed-config artifact schema; fixtures/match_config.example.json is only an example template.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agreed_between",
    "board_and_agents",
    "world",
    "movement_and_barriers",
    "scoring",
    "pheromones",
    "network_and_league",
    "rate_limiter_gatekeeper"
  ],
  "properties": {
    "version": {
      "const": "1.00",
      "description": "OPTIONAL. The guidelines configuration revision. Appendix B's game.json structure does not carry it, so requiring it would reject a conforming opponent; the internal contract version lives in CONTRACT_VERSION instead. Accepted when present."
    },
    "schema_version": {
      "const": "1.2",
      "description": "Appendix B example profile; compatibility with 1.1/1.3 is unresolved."
    },
    "agreed_between": {
      "type": "array",
      "description": "The two agreed group IDs. Array order is byte-significant and preserved; it is never silently sorted.",
      "prefixItems": [
        {
          "$ref": "#/$defs/participant"
        },
        {
          "$ref": "#/$defs/participant"
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "board_and_agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid_size",
        "num_agents",
        "thief_start",
        "cop_start",
        "axis_origin_corner",
        "axis_start_index"
      ],
      "properties": {
        "grid_size": {
          "type": "integer",
          "minimum": 7,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "num_agents": {
          "const": 2,
          "x-appendix-f-status": "fixed",
          "x-value-owner": "appendix_f"
        },
        "thief_start": {
          "$ref": "#/$defs/coordinate",
          "x-appendix-f-status": "negotiated",
          "x-value-owner": "mutual_agreement"
        },
        "cop_start": {
          "$ref": "#/$defs/coordinate",
          "x-appendix-f-status": "negotiated",
          "x-value-owner": "mutual_agreement"
        },
        "axis_origin_corner": {
          "type": "string",
          "minLength": 1,
          "x-appendix-f-status": "negotiated",
          "x-value-owner": "mutual_agreement"
        },
        "axis_start_index": {
          "type": "integer",
          "minimum": 0,
          "description": "PROJECT-PROPOSED lower bound. Appendix F gives the negotiated default 0 and states no bound; a negative start index has no defined meaning for a board addressed by inclusive non-negative indices, so it is rejected rather than silently accepted.",
          "x-appendix-f-status": "negotiated",
          "x-value-owner": "mutual_agreement",
          "x-bound-status": "PROJECT-PROPOSED"
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_area",
        "hint_max_words"
      ],
      "properties": {
        "map_area": {
          "type": "string",
          "x-appendix-f-status": "negotiated",
          "x-value-owner": "mutual_agreement"
        },
        "hint_max_words": {
          "type": "integer",
          "minimum": 0,
          "x-appendix-f-status": "negotiated",
          "x-value-owner": "mutual_agreement"
        }
      }
    },
    "movement_and_barriers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_set",
        "max_barriers",
        "max_moves",
        "survival_threshold"
      ],
      "properties": {
        "move_set": {
          "const": [
            "N",
            "S",
            "E",
            "W",
            "STAY"
          ],
          "x-appendix-f-status": "fixed",
          "x-value-owner": "appendix_f"
        },
        "max_barriers": {
          "type": "integer",
          "minimum": 14,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "max_moves": {
          "type": "integer",
          "minimum": 35,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "survival_threshold": {
          "type": "integer",
          "minimum": 35,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_cop",
        "capture_thief",
        "survival_cop",
        "survival_thief",
        "tie_score",
        "technical_loss"
      ],
      "properties": {
        "capture_cop": {
          "const": 20
        },
        "capture_thief": {
          "const": 5
        },
        "survival_cop": {
          "const": 5
        },
        "survival_thief": {
          "const": 10
        },
        "tie_score": {
          "const": 2
        },
        "technical_loss": {
          "const": 0
        }
      },
      "x-appendix-f-status": "fixed",
      "x-value-owner": "appendix_f"
    },
    "pheromones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pheromone_center_intensity",
        "pheromone_decay",
        "pheromone_grid_size"
      ],
      "properties": {
        "pheromone_center_intensity": {
          "const": 0.9
        },
        "pheromone_decay": {
          "const": 0.1
        },
        "pheromone_grid_size": {
          "const": 5
        }
      },
      "x-appendix-f-status": "fixed",
      "x-value-owner": "appendix_f"
    },
    "network_and_league": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_timeout_sec",
        "watchdog_timeout_sec",
        "num_games",
        "diversity_reward",
        "min_games_to_pass",
        "max_games_per_team",
        "token_budget_per_series"
      ],
      "properties": {
        "response_timeout_sec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-appendix-f-status": "negotiated",
          "x-value-owner": "mutual_agreement"
        },
        "watchdog_timeout_sec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-appendix-f-status": "negotiated",
          "x-value-owner": "mutual_agreement"
        },
        "num_games": {
          "const": 6,
          "x-appendix-f-status": "fixed",
          "x-value-owner": "appendix_f"
        },
        "diversity_reward": {
          "const": 10,
          "x-appendix-f-status": "fixed",
          "x-value-owner": "appendix_f"
        },
        "min_games_to_pass": {
          "const": 2,
          "x-appendix-f-status": "fixed",
          "x-value-owner": "appendix_f"
        },
        "max_games_per_team": {
          "const": 10,
          "x-appendix-f-status": "fixed",
          "x-value-owner": "appendix_f"
        },
        "token_budget_per_series": {
          "type": "integer",
          "minimum": 0,
          "x-appendix-f-status": "negotiated",
          "x-value-owner": "mutual_agreement"
        }
      }
    },
    "rate_limiter_gatekeeper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_per_minute",
        "concurrent_requests",
        "retry_backoff_sec",
        "max_retries",
        "queue_depth"
      ],
      "properties": {
        "requests_per_minute": {
          "type": "integer",
          "minimum": 30,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "concurrent_requests": {
          "type": "integer",
          "minimum": 2,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "retry_backoff_sec": {
          "type": "number",
          "minimum": 5,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 3,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        },
        "queue_depth": {
          "type": "integer",
          "minimum": 100,
          "x-appendix-f-status": "minimum",
          "x-value-owner": "mutual_agreement"
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "OPTIONAL. PROPOSED explicit extension namespace; contents must be mutually agreed. Not part of Appendix B's game.json structure, so it is never required of an opponent."
    }
  },
  "$defs": {
    "participant": {
      "type": "string",
      "minLength": 1
    },
    "coordinate": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
