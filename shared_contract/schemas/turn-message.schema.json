{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-version": "0.2.4-proposed",
  "x-role-neutral": true,
  "x-compatibility-profile": "simulator-v3.0.0",
  "title": "simulator-v3.0.0 TurnMessage",
  "description": "Public per-turn event for the simulator-v3.0.0 compatibility profile. Extra fields are tolerated, but true position, move, intent/verdict, and the per-turn commitment nonce must never appear before the post-game audit.",
  "type": "object",
  "required": ["step", "sender", "hint", "smell_grid", "commit", "timestamp"],
  "additionalProperties": true,
  "properties": {
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "sender": {
      "enum": ["police", "thief"]
    },
    "hint": {
      "type": "string"
    },
    "smell_grid": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]+,[0-9]+$"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "barrier_placed": {
      "anyOf": [
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "type": "null"
        }
      ]
    },
    "capture_claim": {
      "anyOf": [
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim_response": {
      "anyOf": [
        {
          "type": "object",
          "required": ["claim", "caught"],
          "additionalProperties": false,
          "properties": {
            "claim": {
              "$ref": "#/$defs/coordinate"
            },
            "caught": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "win_claim": {
      "anyOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "survival"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "coordinate": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  },
  "not": {
    "anyOf": [
      {
        "required": ["position"]
      },
      {
        "required": ["move"]
      },
      {
        "required": ["nonce"]
      },
      {
        "required": ["intent"]
      },
      {
        "required": ["verdict"]
      }
    ]
  }
}
