{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-version": "0.2.5-proposed",
  "x-role-neutral": true,
  "title": "Option-B per-sub-game config artifact",
  "description": "Emitted config artifact wrapping one sub-game's agreed match object. The config_sha256 claim is stored outside the hashed game object. Exhaustive artifact rules remain M7 work.",
  "type": "object",
  "required": ["game_id", "game_uid", "links", "sub_game", "config", "config_sha256"],
  "additionalProperties": true,
  "properties": {
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "game_uid": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "object",
      "required": ["config", "log"],
      "additionalProperties": true,
      "properties": {
        "config": {
          "type": "string",
          "pattern": "g<NN>"
        },
        "log": {
          "type": "string",
          "pattern": "g<NN>"
        }
      }
    },
    "sub_game": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "config": {
      "type": "object"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
